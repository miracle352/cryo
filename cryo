#!/usr/bin/env python3
"""cryo - keep processes alive across Sprite cold wakes, host moves and checkpoint restores.

Runs as root. Every managed process is started by cryo (so it is root-owned and
CRIU can ptrace it without CAP_SYS_PTRACE), frozen to disk with CRIU, and thawed
again when cryo notices the machine has rebooted (boot_id changed).
"""
import argparse
import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
import time

STATE = os.environ.get("CRYO_HOME", "/var/lib/cryo")
EVENTS = os.path.join(STATE, "events.jsonl")


_BOOT = None


def boot_id():
    """Identity of the current environment. A Sprite checkpoint restore restarts
    the container but not the VM kernel, so the kernel boot_id stays the same.
    Combine it with the start time of PID 1 to catch both kinds of restart.
    Cached: a running cryo never outlives a restart, and a flaky read must not
    make live agents look dead."""
    global _BOOT
    if _BOOT is None:
        with open("/proc/sys/kernel/random/boot_id") as f:
            kernel = f.read().strip()
        try:
            with open("/proc/1/stat") as f:
                init_start = f.read().split(") ", 1)[1].split()[19]
        except (OSError, IndexError):
            init_start = "?"
        _BOOT = f"{kernel}/{init_start}"
    return _BOOT


def now():
    return time.time()


# Two kernel features that CRIU can't checkpoint on a Sprite:
#  - io_uring rings (criu has no support for them at all)
#  - inotify watches on regular files: the root fs is an overlay, files report the
#    lower layer's st_dev while the watch records the overlay's, so neither
#    open_by_handle_at (needs CAP_DAC_READ_SEARCH, which Sprites don't grant) nor
#    criu's irmap can find them.
# cryo starts agents under a small seccomp filter that makes these syscalls fail
# with ENOSYS. Runtimes then fall back (libuv/bun -> epoll, file watchers -> off or
# polling). The filter is inherited by children and checkpointed by CRIU itself.
X86_64 = 0xC000003E
BLOCKED_SYSCALLS = {
    "io_uring_setup": 425,
    "inotify_init": 253,
    "inotify_init1": 294,
    "fanotify_init": 300,
}


def seccomp_blocker(blocked=tuple(BLOCKED_SYSCALLS.values()), errno_=38):
    import ctypes
    import struct

    def ins(code, jt, jf, k):
        return struct.pack("HBBI", code, jt, jf, k)

    LD_ABS, JEQ, RET = 0x20, 0x15, 0x06
    allow, deny = 0x7FFF0000, 0x00050000 | errno_
    n = len(blocked)
    prog = [ins(LD_ABS, 0, 0, 4),                 # arch
            ins(JEQ, 0, n + 2, X86_64),           # not x86_64 -> allow
            ins(LD_ABS, 0, 0, 0)]                 # syscall nr
    for i, nr in enumerate(blocked):
        prog.append(ins(JEQ, n - i, 0, nr))       # match -> deny
    prog += [ins(RET, 0, 0, allow), ins(RET, 0, 0, deny)]
    raw = b"".join(prog)

    def apply():
        libc = ctypes.CDLL(None, use_errno=True)
        buf = ctypes.create_string_buffer(raw, len(raw))

        class SockFprog(ctypes.Structure):
            _fields_ = [("len", ctypes.c_ushort), ("filter", ctypes.c_void_p)]
        fp = SockFprog(len(prog), ctypes.addressof(buf))
        if libc.prctl(38, 1, 0, 0, 0) != 0:                      # PR_SET_NO_NEW_PRIVS
            raise OSError(ctypes.get_errno(), "PR_SET_NO_NEW_PRIVS")
        if libc.prctl(22, 2, ctypes.byref(fp), 0, 0) != 0:       # PR_SET_SECCOMP, FILTER
            raise OSError(ctypes.get_errno(), "PR_SET_SECCOMP")
    return apply


# statuses cryo must not thaw on its own: stopped by hand (stop, freeze --stop),
# exited on its own, given up on after failed thaws, or on its way to / already
# living on another Sprite
PARKED = ("stopped", "frozen", "exited", "failed", "leaving", "away", "moved", "arriving")


def agent_dir(name):
    return os.path.join(STATE, "agents", name)


def load(name):
    p = os.path.join(agent_dir(name), "meta.json")
    if not os.path.exists(p):
        sys.exit(f"cryo: no agent named {name!r}")
    with open(p) as f:
        return json.load(f)


def save(meta):
    d = agent_dir(meta["name"])
    os.makedirs(d, exist_ok=True)
    tmp = os.path.join(d, "meta.json.tmp")
    with open(tmp, "w") as f:
        json.dump(meta, f, indent=2)
    os.replace(tmp, os.path.join(d, "meta.json"))


def all_agents():
    root = os.path.join(STATE, "agents")
    if not os.path.isdir(root):
        return []
    out = []
    for n in sorted(os.listdir(root)):
        try:
            with open(os.path.join(root, n, "meta.json")) as f:
                out.append(json.load(f))
        except (OSError, ValueError):
            continue   # gone or half-written: skip it this round
    return out


def event(kind, name, **kw):
    os.makedirs(STATE, exist_ok=True)
    rec = {"t": now(), "kind": kind, "agent": name, "boot_id": boot_id(), **kw}
    try:
        with open(EVENTS, "a") as f:
            f.write(json.dumps(rec) + "\n")
        if os.path.getsize(EVENTS) > 4 << 20:   # keep the log from growing forever
            with open(EVENTS) as f:
                keep = f.readlines()[-3000:]
            with open(EVENTS + ".tmp", "w") as f:
                f.writelines(keep)
            os.replace(EVENTS + ".tmp", EVENTS)
    except OSError:
        pass   # a full disk must not take freezing and thawing down with it


class agent_lock:
    """One freeze, thaw or status change per agent at a time, across the watch
    service, the api and the cli. Inside the lock, re-read meta.json: the dict a
    caller loaded earlier may be stale (someone may have stopped the agent)."""
    def __init__(self, name):
        self.name = name

    def __enter__(self):
        import fcntl
        d = agent_dir(self.name)
        os.makedirs(d, exist_ok=True)
        self.f = open(os.path.join(d, "lock"), "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        self.f.close()


def fresh(meta):
    """Reload meta from disk into the caller's dict (callers keep using it)."""
    try:
        with open(os.path.join(agent_dir(meta["name"]), "meta.json")) as f:
            disk = json.load(f)
        meta.clear()
        meta.update(disk)
    except (OSError, ValueError):
        pass
    return meta


def alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    # zombies count as dead
    try:
        with open(f"/proc/{pid}/stat") as f:
            return f.read().split(") ", 1)[1][0] != "Z"
    except FileNotFoundError:
        return False


def proc_start(pid):
    """When a process started (clock ticks since boot): with the PID, it names
    one process for good. A reused PID gets a different start time."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            return int(f.read().split(") ", 1)[1].split()[19])
    except (OSError, IndexError, ValueError):
        return None


def agent_alive(m):
    """The agent's own process is running. A PID alone isn't enough: after a
    restart a boot process can get the same PID. Compare the process's start
    time with the one recorded when cryo started or thawed it. (Not the
    environment id: we've seen a Sprite change PID 1 under running agents.)"""
    pid = m.get("pid")
    if not alive(pid):
        return False
    if m.get("pid_start") is not None:
        return proc_start(pid) == m["pid_start"]
    return True   # recorded before cryo kept start times; filled in at its next freeze


def images_dir(d):
    """The current images, recovering from a restart in the middle of a swap
    (images renamed to images.old, the new set not yet renamed in)."""
    cur, old = os.path.join(d, "images"), os.path.join(d, "images.old")
    if not os.path.isdir(cur) and os.path.isdir(old):
        os.rename(old, cur)
    return cur


def in_seccomp():
    try:
        with open("/proc/self/status") as f:
            return any(l.startswith("Seccomp:") and l.split()[1] != "0" for l in f)
    except OSError:
        return False


def dir_size(path):
    total = 0
    for root, _, files in os.walk(path):
        for fn in files:
            try:
                total += os.path.getsize(os.path.join(root, fn))
            except OSError:
                pass
    return total


# Open TCP connections (an agent talking to its model API) are dumped with
# --tcp-established and come back closed (--tcp-close); the client reconnects.
# CRIU normally locks them with iptables while dumping, but there's no iptables
# on a Sprite and we don't need the lock when the sockets are restored closed.
CRIU_TIMEOUT = 600


def to_root_cgroup():
    """Sprite services run in their own cgroups (/svc.<name>), and work started
    from there runs far slower than from a shell: a dump that takes 0.05 s from
    a terminal took 6-40 s from the cryo services. Run criu from the top cgroup,
    which also leaves thawed agents there instead of inside a service's group."""
    try:
        with open("/sys/fs/cgroup/cgroup.procs", "w") as f:
            f.write(str(os.getpid()))
    except OSError:
        pass


def criu(args, log_dir):
    """Run criu, return (ok, seconds, error_lines)."""
    t0 = now()
    try:
        r = subprocess.run(["criu"] + args, capture_output=True, text=True, preexec_fn=to_root_cgroup,
                           timeout=CRIU_TIMEOUT)
    except subprocess.TimeoutExpired:
        # killing criu lets seized tasks run on; better than blocking every agent forever
        return False, now() - t0, [f"criu gave up after {CRIU_TIMEOUT}s"]
    dt = now() - t0
    errs = []
    for line in (r.stderr or "").splitlines():
        # this one is noise on Sprites: no CAP_SYS_RESOURCE, criu carries on
        if "RLIMIT_NOFILE" in line:
            continue
        if "Error" in line:
            errs.append(line.strip())
    log = os.path.join(log_dir, "dump.log" if args[0] == "dump" else "restore.log")
    if os.path.exists(log):
        with open(log) as f:
            errs += [l.strip() for l in f if "Error" in l and "RLIMIT_NOFILE" not in l][-8:]
    return r.returncode == 0, dt, errs


# ---------------------------------------------------------------- commands

def high_pids():
    """CRIU restores a process with its original PID. After a restart, early boot
    processes get low PIDs, so start agents far above them to avoid collisions."""
    try:
        with open("/proc/sys/kernel/pid_max") as f:
            pid_max = int(f.read())
        import random
        if pid_max > 200000:
            base, spread = min(pid_max - 100000, 300000), 50000
        else:
            # Sprites use pid_max 32768: take the top quarter
            base, spread = pid_max * 3 // 4, pid_max // 4 - 2000
        if spread > 0:
            with open("/proc/sys/kernel/ns_last_pid", "w") as f:
                f.write(str(base + random.randint(0, spread)))
    except (OSError, ValueError):
        pass


def cmd_run(a):
    name = a.name
    if os.path.exists(os.path.join(agent_dir(name), "meta.json")) and agent_alive(load(name)):
        sys.exit(f"cryo: {name} is already running")
    d = agent_dir(name)
    os.makedirs(d, exist_ok=True)
    # an older run's snapshot must not come back in place of this one
    for old in ("images", "images.old", "images.new"):
        shutil.rmtree(os.path.join(d, old), ignore_errors=True)
    env = dict(os.environ)
    env["UV_USE_IO_URING"] = "0"
    blocker = None if a.no_filter else seccomp_blocker()
    command = a.command
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        sys.exit("cryo run: give a command, e.g. cryo run web -- python3 app.py")

    high_pids()
    if a.tmux:
        sock = f"cryo-{name}"
        shell_cmd = " ".join(shlex.quote(c) for c in command)
        subprocess.run(["tmux", "-L", sock, "kill-server"], capture_output=True)
        subprocess.run(["tmux", "-L", sock, "new", "-d", "-s", name, "-x", "200", "-y", "50", shell_cmd],
                       cwd=a.cwd, env=env, check=True, preexec_fn=blocker)
        time.sleep(0.5)
        r = subprocess.run(["tmux", "-L", sock, "display", "-p", "-t", name, "#{pid}"],
                           capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit(f"cryo: tmux session for {name} died right away:\n{r.stderr}")
        pid = int(r.stdout.strip())
    else:
        log = open(os.path.join(d, "output.log"), "ab")
        p = subprocess.Popen(command, cwd=a.cwd, env=env, stdin=subprocess.DEVNULL,
                             stdout=log, stderr=log, start_new_session=True,
                             preexec_fn=blocker)
        pid = p.pid

    meta = {
        "name": name, "command": command, "cwd": a.cwd, "tmux": a.tmux,
        "pid": pid, "pid_start": proc_start(pid), "status": "running", "started": now(), "boot_id": boot_id(),
        "last_freeze": None, "freeze_seconds": None, "image_bytes": None,
        "thaws": 0,
    }
    save(meta)
    event("run", name, pid=pid, command=command)
    print(f"cryo: {name} running as pid {pid}")


def process_tree(pid):
    kids = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/stat") as f:
                ppid = int(f.read().split(") ", 1)[1].split()[1])
        except (OSError, IndexError, ValueError):
            continue
        kids.setdefault(ppid, []).append(int(d))
    out, todo = [], [pid]
    while todo:
        p = todo.pop()
        out.append(p)
        todo += kids.get(p, [])
    return out


def tree_cpu(pid):
    """Total CPU ticks (user+sys) used by a process tree. CRIU's own dirty-page
    tracking needs soft-dirty, which the Sprite kernel doesn't have, so cryo uses
    CPU time as a cheap "did anything happen?" signal: a process that didn't run
    can't have changed its memory."""
    total = 0
    for p in process_tree(pid):
        try:
            with open(f"/proc/{p}/stat") as f:
                fields = f.read().split(") ", 1)[1].split()
            total += sum(int(x) for x in fields[11:15])   # utime stime cutime cstime
        except (OSError, IndexError, ValueError):
            pass
    return total


def watched_inodes(pid):
    """(dev, ino) of everything the process tree watches with inotify."""
    found = set()
    for p in process_tree(pid):
        try:
            fds = os.listdir(f"/proc/{p}/fdinfo")
        except OSError:
            continue
        for fd in fds:
            try:
                with open(f"/proc/{p}/fdinfo/{fd}") as f:
                    for line in f:
                        if line.startswith("inotify "):
                            kv = dict(x.split(":", 1) for x in line.split()[1:] if ":" in x)
                            sdev = int(kv["sdev"], 16)  # kernel dev_t: major<<20 | minor
                            found.add((sdev >> 20, sdev & 0xFFFFF, int(kv["ino"], 16)))
            except (OSError, KeyError, ValueError):
                continue
    return found


SKIP = {"node_modules", ".git", ".cache", "proc", "sys", ".npm", ".cargo", "site-packages"}


def irmap_paths(meta):
    """criu's irmap scan of a hint directory only looks one level deep, so give it
    the exact parent directory of every watched file. Find those by walking the
    usual places (cwd, home, /root, /tmp, /etc) a few levels down."""
    want = watched_inodes(meta["pid"])
    if not want:
        return []
    roots = [meta.get("cwd"), os.environ.get("HOME"), "/home", "/root", "/tmp", "/etc"]
    hits = set()

    def walk(path, depth):
        if not want or depth < 0:
            return
        try:
            entries = list(os.scandir(path))
        except OSError:
            return
        for e in entries:
            try:
                st = e.stat(follow_symlinks=False)
            except OSError:
                continue
            key = (os.major(st.st_dev), os.minor(st.st_dev), st.st_ino)
            if key in want:
                want.discard(key)
                hits.add(path)
                if e.is_dir(follow_symlinks=False):
                    hits.add(e.path)
            if e.is_dir(follow_symlinks=False) and e.name not in SKIP:
                walk(e.path, depth - 1)

    for r in roots:
        if r and os.path.isdir(r):
            try:
                st = os.stat(r)
                key = (os.major(st.st_dev), os.minor(st.st_dev), st.st_ino)
                if key in want:
                    want.discard(key)
                    hits.add(os.path.dirname(r) or "/")
                    hits.add(r)
            except OSError:
                pass
            walk(r, 4)
    if want:
        for maj, mnr, ino in sorted(want):
            print(f"cryo: warning, watched inode {ino} on dev {maj}:{mnr} not located"
                  " (deleted or replaced file?)", file=sys.stderr)
    return sorted(hits)


def freeze(meta, leave_running, status=None):
    if in_seccomp():
        return False, (f"{meta['name']}: can't freeze from inside a cryo agent (the kernel won't let a "
                       f"process under seccomp suspend another's); ask cryo serve or run it from a shell")
    with agent_lock(meta["name"]):
        fresh(meta)
        if status is None and meta.get("status") in PARKED:
            return False, f"{meta['name']}: {meta['status']}, left alone"
        if status:
            meta["status"] = status    # before the dump, so nobody thaws it mid-way
            save(meta)
        return _freeze(meta, leave_running, status)


def _freeze(meta, leave_running, status):
    name = meta["name"]
    d = agent_dir(name)
    if not agent_alive(meta):
        return False, f"{name}: not running"
    images_dir(d)
    new = os.path.join(d, "images.new")
    shutil.rmtree(new, ignore_errors=True)
    os.makedirs(new)
    args = ["dump", "-t", str(meta["pid"]), "-D", new, "-o", "dump.log",
            "--tcp-established", "--file-locks", "--network-lock", "skip"]
    if meta.get("tmux"):
        args.append("--ext-unix-sk")
    # File watchers (inotify) are normally dumped as kernel file handles, which
    # needs CAP_DAC_READ_SEARCH. Sprites don't grant it, so make criu resolve
    # watched paths by scanning instead (irmap). Point it at the likely places.
    paths = irmap_paths(meta)
    if paths:
        args.append("--force-irmap")
        for path in paths:
            args += ["--irmap-scan-path", path]
    if leave_running:
        args.append("--leave-running")
    ok, dt, errs = criu(args, new)
    if not ok:
        event("freeze_failed", name, errors=errs)
        return False, f"{name}: freeze failed\n  " + "\n  ".join(errs[-6:])
    # Sprites don't grant CAP_SYS_TIME, so restoring a time namespace fails.
    for fn in os.listdir(new):
        if fn.startswith("timens-"):
            os.remove(os.path.join(new, fn))
    cur = os.path.join(d, "images")
    old = os.path.join(d, "images.old")
    shutil.rmtree(old, ignore_errors=True)
    if os.path.exists(cur):
        os.rename(cur, old)        # a restart right here is undone by images_dir()
    os.rename(new, cur)
    shutil.rmtree(old, ignore_errors=True)
    paused = paused_seconds(cur)
    meta.update(last_freeze=now(), freeze_seconds=round(dt, 3), paused_seconds=paused,
                cpu_at_freeze=tree_cpu(meta["pid"]), image_bytes=dir_size(cur), boot_id=boot_id(),
                pid_start=meta.get("pid_start") or proc_start(meta["pid"]),
                mono_at_freeze=time.monotonic(),
                status=status or ("running" if leave_running else "frozen"))
    save(meta)
    event("freeze", name, seconds=round(dt, 3), paused=paused, bytes=meta["image_bytes"],
          leave_running=leave_running)
    mb = meta["image_bytes"] / 1e6
    if paused is not None and leave_running:
        return True, f"{name}: frozen in {dt:.2f}s, the agent was paused for {paused:.2f}s ({mb:.1f} MB)"
    return True, f"{name}: frozen in {dt:.2f}s ({mb:.1f} MB)"


def paused_seconds(images):
    """How long the process was actually stopped. With --leave-running it runs
    again while criu is still writing pages to disk, so the dump's wall time
    overstates it (on a Sprite the write is most of it: ~50 MB/s)."""
    try:
        crit = shutil.which("crit") or next((p for p in ("/usr/bin/crit", "/usr/sbin/crit",
                                                          "/usr/local/bin/crit") if os.path.exists(p)), "crit")
        r = subprocess.run([crit, "show", os.path.join(images, "stats-dump")],
                           capture_output=True, text=True, timeout=10)
        d = json.loads(r.stdout)["entries"][0]["dump"]
        return round((int(d["freezing_time"]) + int(d["frozen_time"])) / 1e6, 3)
    except (OSError, ValueError, KeyError, IndexError, subprocess.SubprocessError):
        return None


def thaw(meta, extra=()):
    with agent_lock(meta["name"]):
        fresh(meta)
        return _thaw(meta, extra)


def _thaw(meta, extra=()):
    name = meta["name"]
    d = agent_dir(name)
    img = images_dir(d)
    if meta.get("came_from") and MOVED_ARGS[0] not in extra:
        extra = tuple(extra) + MOVED_ARGS   # its images may still name the other Sprite's cgroups
    if agent_alive(meta):
        return False, f"{name}: already running (pid {meta['pid']})"
    if not os.path.isdir(img):
        return False, f"{name}: nothing frozen to thaw"
    if os.path.exists(f"/proc/{meta['pid']}"):
        event("thaw_failed", name, errors=[f"pid {meta['pid']} is taken by another process"])
        return False, f"{name}: pid {meta['pid']} is taken by another process, can't thaw"
    pidfile = os.path.join(d, "thaw.pid")
    if os.path.exists(pidfile):
        os.remove(pidfile)
    args = ["restore", "-D", img, "-o", "restore.log", "-d", "--tcp-close",
            "--file-locks", "--network-lock", "skip", "--pidfile", pidfile]
    if meta.get("tmux"):
        args.append("--ext-unix-sk")
    args += list(extra)
    ok, dt, errs = criu(args, img)
    if not ok:
        event("thaw_failed", name, errors=errs)
        return False, f"{name}: thaw failed\n  " + "\n  ".join(errs[-6:])
    pid = meta["pid"]
    if os.path.exists(pidfile):
        with open(pidfile) as f:
            pid = int(f.read().strip())
    lost = now() - (meta.get("last_freeze") or now())
    # finding 7: after a kernel reboot this clock restarts near zero; every timer
    # in the agent then waits until it catches up. Say so instead of staying silent.
    behind = (meta.get("mono_at_freeze") or 0) - time.monotonic()
    # restored tasks start with fresh CPU counters; re-baseline the activity check
    meta.update(pid=pid, pid_start=proc_start(pid), status="running", boot_id=boot_id(),
                thaws=meta.get("thaws", 0) + 1,
                cpu_at_freeze=tree_cpu(pid), thaw_failures=0)
    save(meta)
    event("thaw", name, seconds=round(dt, 3), pid=pid, since_freeze=round(lost, 1),
          **({"clock_behind": round(behind)} if behind > 60 else {}))
    note = f"; its clock went back {behind / 3600:.1f}h, so its timers wait that long" if behind > 60 else ""
    return True, f"{name}: thawed in {dt:.2f}s as pid {pid} (state from {lost:.0f}s before){note}"


def cmd_freeze(a):
    targets = all_agents() if a.all else [load(a.name)]
    rc = 0
    for m in targets:
        ok, msg = freeze(m, leave_running=not a.stop)
        print("cryo:", msg)
        rc |= not ok
    sys.exit(rc)


def cmd_thaw(a):
    targets = all_agents() if a.all else [load(a.name)]
    rc = 0
    for m in targets:
        if m["status"] == "moved" and not a.force:
            print(f"cryo: {m['name']} lives on {m.get('moved_to', 'another Sprite')} now "
                  f"(thaw --force would make a second copy)")
            rc = 1
            continue
        recalled = m["status"] in ("away", "leaving")
        arriving = bool(m.get("landing"))
        ok, msg = thaw(m)
        if ok and arriving:
            landed(load(m["name"]), msg)
            continue
        if ok and recalled:
            # called back: the teleport link must stop working
            tickets = load_tickets()
            for k in [k for k, t in tickets.items() if t["name"] == m["name"]]:
                if tickets[k].get("fetched"):
                    print(f"cryo: careful: {m['name']} was already pulled by another Sprite")
                try:
                    os.remove(tickets[k]["bundle"])   # it holds the whole process memory
                except OSError:
                    pass
                del tickets[k]
            save_tickets(tickets)
        print("cryo:", msg)
        rc |= not ok
    sys.exit(rc)


def cmd_boot(a, retry=None):
    """Thaw every agent whose process died because the machine restarted."""
    back, lost = [], []
    for m in all_agents():
        ok, msg = revive(m, retry)
        if msg:
            print("cryo:", msg, flush=True)
        if ok is not None:      # revive only thaws (or gives up) after a restart
            (back if ok else lost).append(msg)
    if back or lost:
        restart_alert(back, lost)


def revive(m, retry=None):
    """Decide what to do with an agent that isn't running.
    Returns (None, "") when there's nothing to do, else (thawed?, message).

    Only a restart brings an agent back. One that exits or is killed while the
    Sprite stays up is marked exited and left alone: thawing it would replay
    whatever it did after its last snapshot, and a crash would loop forever.
    Failed thaws back off and, after a few tries, give up with an alert."""
    if m["status"] in PARKED or agent_alive(m):
        return None, ""
    name = m["name"]
    if m.get("boot_id") == boot_id():
        with agent_lock(name):
            fresh(m)
            if m["status"] in PARKED or agent_alive(m):
                return None, ""
            m["status"] = "exited"
            save(m)
        event("exited", name)
        return None, f"{name}: exited on its own; left alone (cryo thaw {name} brings it back)"
    if retry is not None and time.monotonic() < retry.get(name, (0, 0))[1]:
        return None, ""
    event("reboot_detected", name, old_boot_id=m.get("boot_id"))
    ok, msg = thaw(m)
    if not ok:
        n = (retry or {}).get(name, (0, 0))[0] + 1
        if retry is not None:
            retry[name] = (n, time.monotonic() + min(60, 2 ** n))
        if retry is None or n >= 5:
            with agent_lock(name):
                fresh(m)
                m["status"] = "failed"
                save(m)
            event("gave_up", name, tries=n)
            return False, msg + f"\n  (gave up after {n} tries; cryo thaw {name} to try again)"
        return None, ""
    if retry is not None:
        retry.pop(name, None)
    return True, msg


def restart_alert(back, lost):
    """One email per restart, not one per agent. A Sprite whose restart button is
    public can be restarted by anyone, so good news is sent at most once every
    `alert_every` seconds (default 30 min); an agent that didn't come back is
    always sent."""
    c = load_config()
    every = c.get("alert_every", 1800)
    if not lost and now() - c.get("last_restart_alert", 0) < every:
        event("alert_skipped", "*", reason=f"one restart email per {every // 60} min")
        return
    n = len(back) + len(lost)
    subject = (f"cryo: {len(lost)} of {n} agents did NOT come back" if lost
               else f"cryo: {'all ' + str(n) + ' agents' if n > 1 else 'your agent'} survived a restart")
    body = "\n".join(lost + back) + (f"\n\nSprite: {sprite_name()}\n"
                                      f"Time: {time.strftime('%Y-%m-%d %H:%M:%S UTC', time.gmtime())}")
    if send_alert(subject, body):
        c = load_config()
        c["last_restart_alert"] = now()
        save_config(c)


def cmd_watch(a):
    """Thaw anything that died, then keep a fresh frozen copy of everything running.

    A Sprite pauses whenever nothing is using it, and paused processes can't change,
    so cryo only re-freezes an agent after it has actually used CPU. It checks every
    couple of seconds and freezes `settle` seconds after activity, or at least every
    `interval` seconds of awake time while the agent stays busy."""
    print(f"cryo: watching (freeze {a.settle}s after activity, at most every {a.interval}s while busy)",
          flush=True)
    retry = {}         # name -> (failed thaws, monotonic time of next try)
    cmd_boot(a, retry)
    stop = False

    def bye(*_):
        nonlocal stop
        stop = True
    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)
    seen = {}          # name -> (cpu ticks at last check, monotonic time of last burst)
    burst = {}         # name -> cpu ticks spent in bursts since our last freeze
    froze_at = {}      # name -> monotonic time of our last freeze
    while not stop:
        t = time.monotonic()
        for m in all_agents():
            try:
                watch_one(m, a, t, seen, burst, froze_at, retry)
            except Exception as e:   # one agent's trouble must not stop the others
                print(f"cryo: {m.get('name')}: {type(e).__name__}: {e}", flush=True)
                event("watch_error", m.get("name"), error=f"{type(e).__name__}: {e}"[:300])
        for _ in range(20):
            if stop:
                break
            time.sleep(0.1)


def watch_one(m, a, t, seen, burst, froze_at, retry):
    if m["status"] in PARKED:
        return
    name = m["name"]
    if not agent_alive(m):
        ok, msg = revive(m, retry)
        if msg:
            print("cryo:", msg, flush=True)
        if ok is False:
            restart_alert([], [msg])
        seen.pop(name, None)
        burst.pop(name, None)
        return
    cpu = tree_cpu(m["pid"])
    prev = seen.get(name)
    last_burst = prev[1] if prev else t
    if prev is not None:
        step = cpu - prev[0]
        # an idle agent still ticks (timers, a blinking cursor, a spinner).
        # only checks where it used a real slice of CPU count as work, so
        # background ticking never adds up to a snapshot on its own
        if step >= a.burst:
            burst[name] = burst.get(name, 0) + step
            last_burst = t
    seen[name] = (cpu, last_burst)
    quiet = t - last_burst >= a.settle
    base = m.get("cpu_at_freeze")
    worked = base is None or burst.get(name, 0) >= a.work_ticks
    since = t - froze_at.get(name, -1e9)
    drifted = base is not None and cpu - base > 3 and since >= a.drift
    has_image = os.path.isdir(os.path.join(agent_dir(name), "images"))
    if not has_image or (worked and (quiet or since >= a.interval)) or drifted:
        ok, msg = freeze(m, leave_running=True)
        froze_at[name] = time.monotonic()
        burst[name] = 0
        # criu runs code inside the process while dumping it; that CPU is
        # ours, not the agent's, so don't let the next check count it as work
        seen[name] = (tree_cpu(m["pid"]), seen[name][1])
        if not ok:
            print("cryo:", msg, flush=True)


def cmd_stop(a):
    m = load(a.name)
    with agent_lock(a.name):
        fresh(m)
        m["status"] = "stopped"    # first, so nothing thaws it once it's dead
        save(m)
        if agent_alive(m):
            os.killpg(os.getpgid(m["pid"]), signal.SIGTERM)
    event("stop", a.name)
    print(f"cryo: {a.name} stopped (frozen copy kept)")



# ---------------------------------------------------------------- teleport
#
# Move a running agent to another Sprite. The source does a final dump (the
# process stops), packs the images with every non-system file the process had
# open or mapped, and hands out a one-time ticket. The destination pulls the
# bundle from the source's cryo api, checks it can restore it, and thaws it.
# Until the destination reports back, `cryo thaw NAME` on the source undoes it.

SYSTEM_DIRS = ("/usr/", "/lib/", "/lib32/", "/lib64/", "/bin/", "/sbin/", "/etc/",
               "/proc/", "/sys/", "/dev/", "/run/", "/snap/", "/opt/")
TICKETS = os.path.join(STATE, "tickets.json")
# kernel pseudo-files (/proc/<pid>/..., /dev/pts/...): criu recreates them, nothing to carry or check
VIRTUAL = ("/proc/", "/sys/", "/dev/", "/run/")
# the cgroups a teleported agent lived in belong to the other Sprite; let it join ours
MOVED_ARGS = ("--manage-cgroups=ignore",)


def files_in_use(pid):
    """Regular files the process tree has open or mapped, and every task's cwd."""
    paths, dirs, pids = set(), set(), process_tree(pid)
    socks = set()
    for p in pids:
        try:
            dirs.add(os.readlink(f"/proc/{p}/cwd"))
        except OSError:
            pass
        try:
            for fd in os.listdir(f"/proc/{p}/fd"):
                try:
                    t = os.readlink(f"/proc/{p}/fd/{fd}")
                except OSError:
                    continue
                if t.startswith("/"):
                    paths.add(t)
                elif t.startswith("socket:["):
                    socks.add(t[8:-1])
        except OSError:
            pass
        try:
            with open(f"/proc/{p}/maps") as f:
                for line in f:
                    parts = line.split(None, 5)
                    if len(parts) == 6 and parts[5].startswith("/"):
                        paths.add(parts[5].rstrip("\n"))
        except OSError:
            pass
    # unix sockets bound to a path: criu re-binds them there, so their folders must exist
    try:
        with open("/proc/net/unix") as f:
            next(f)
            for line in f:
                parts = line.split()
                if len(parts) >= 8 and parts[6] in socks and parts[7].startswith("/"):
                    dirs.add(os.path.dirname(parts[7]))
    except OSError:
        pass
    files = []
    for path in sorted(paths):
        if path.endswith(" (deleted)") or path.startswith(VIRTUAL) or not os.path.isfile(path):
            continue
        files.append({"path": path, "size": os.path.getsize(path)})
    return files, sorted(d for d in dirs if not d.endswith(" (deleted)")), pids


def load_tickets():
    try:
        with open(TICKETS) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_tickets(t):
    os.makedirs(STATE, exist_ok=True)
    tmp = TICKETS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(t, f, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, TICKETS)


def sprite_name():
    return load_config().get("sprite") or os.environ.get("SPRITE_NAME") or os.uname().nodename


def cmd_teleport(a):
    import secrets
    import tarfile
    m = load(a.name)
    if not agent_alive(m):
        sys.exit(f"cryo: {a.name} isn't running")
    url = (a.url or load_config().get("url") or "").rstrip("/")
    if not url:
        sys.exit("cryo: the other Sprite pulls the agent from this Sprite's URL.\n"
                 "pass --url https://<this-sprite>.sprites.app (or set it once: cryo install --api --url ...)\n"
                 "the URL must be public (sprite url update --auth public) and cryo-api must be running")
    carry_max = a.carry_max << 20
    files, dirs, pids = files_in_use(m["pid"])
    for f in files:
        f["carried"] = not f["path"].startswith(SYSTEM_DIRS) and f["size"] <= carry_max

    t0 = now()
    ok, msg = freeze(m, leave_running=False, status="leaving")
    if not ok:
        sys.exit("cryo: " + msg + "\n(the agent is still running here)")
    print("cryo:", msg.replace("frozen", "final freeze"), flush=True)

    out = os.path.join(STATE, "outgoing")
    os.makedirs(out, exist_ok=True)
    bundle = os.path.join(out, f"{a.name}.tgz")
    manifest = {"name": a.name, "meta": m, "files": files, "dirs": dirs, "pids": pids,
                "from_sprite": sprite_name(), "from_url": url, "email": load_config().get("email"),
                "packed_at": now(), "monotonic": time.monotonic()}
    with tarfile.open(bundle, "w:gz", compresslevel=1) as tar:
        data = json.dumps(manifest, indent=2).encode()
        info = tarfile.TarInfo("manifest.json")
        info.size = len(data)
        import io
        tar.addfile(info, io.BytesIO(data))
        tar.add(os.path.join(agent_dir(a.name), "images"), arcname="images")
        for f in files:
            if f["carried"]:
                tar.add(f["path"], arcname="files" + f["path"], recursive=False)
    size = os.path.getsize(bundle)
    ticket = secrets.token_urlsafe(24)
    tickets = load_tickets()
    tickets[ticket] = {"name": a.name, "bundle": bundle, "created": now(), "expires": now() + 7200,
                       "frozen_at": t0}
    save_tickets(tickets)
    m["status"] = "away"
    m["away_since"] = now()
    save(m)
    carried = sum(1 for f in files if f["carried"])
    event("teleport", a.name, bytes=size, files=carried)
    pull = f"{url}/api/bundle/{ticket}"
    print(f"cryo: packed {a.name}: {size / 1e6:.1f} MB, {carried} files carried, "
          f"{len(files) - carried} expected on the other side", flush=True)
    if a.to:
        print(f"cryo: asking {a.to} to pull it…", flush=True)
        r = subprocess.run(["sprite", "exec", "-s", a.to, "--", "sudo", "cryo", "import", pull])
        if r.returncode == 0:
            return
        print(f"cryo: that didn't work from here; run it on {a.to} yourself:", flush=True)
    else:
        print("cryo: now run this on the other Sprite (the link lasts 2 hours, until the agent lands):")
    print(f"\n  sudo cryo import {pull}\n")
    print(f"cryo: changed your mind? `sudo cryo thaw {a.name}` here brings it back.")


def download(url, path):
    import urllib.request
    req = urllib.request.Request(url, headers={"X-Cryo-Import": "1", "User-Agent": "cryo"})
    with urllib.request.urlopen(req, timeout=60) as r, open(path, "wb") as f:
        total = int(r.headers.get("Content-Length") or 0)
        got, shown = 0, -1
        while True:
            chunk = r.read(1 << 20)
            if not chunk:
                break
            f.write(chunk)
            got += len(chunk)
            pct = int(got * 100 / total) if total else -1
            if total and pct // 10 != shown:
                shown = pct // 10
                print(f"cryo: pulling {got / 1e6:.0f}/{total / 1e6:.0f} MB", flush=True)
    return got


def cmd_import(a):
    import tarfile
    t0 = now()
    inc = os.path.join(STATE, "incoming")
    os.makedirs(inc, exist_ok=True)
    path = os.path.join(inc, "bundle.tgz")
    try:
        download(a.url, path)
    except Exception as e:
        sys.exit(f"cryo: couldn't pull the agent: {e}")
    t_pull = now() - t0
    with tarfile.open(path, "r:gz") as tar:
        man = json.load(tar.extractfile("manifest.json"))
        name, meta = man["name"], man["meta"]
        problems = []
        if os.path.exists(os.path.join(agent_dir(name), "meta.json")) and agent_alive(load(name)):
            problems.append(f"an agent called {name} is already running here")
        # programs time their timers with CLOCK_MONOTONIC, which counts from each Sprite's
        # boot. Sprites can't give a process its own clock (no CAP_SYS_TIME, so no time
        # namespace), so landing on a Sprite whose clock is behind leaves every timer in
        # the agent waiting until this clock catches up. Ahead is fine: that's a pause.
        if "monotonic" in man:
            behind = man["monotonic"] + (now() - man["packed_at"]) - time.monotonic()
            if behind > 5 and not a.force:
                problems.append(
                    f"this Sprite's clock is {behind / 3600:.1f}h behind {man['from_sprite']}'s; the agent's "
                    f"timers would stall that long. Move agents toward the Sprite that has been up "
                    f"longer (`cat /proc/uptime` on both), or --force")
        taken = [p for p in man["pids"] if os.path.exists(f"/proc/{p}")]
        if taken:
            problems.append(f"pids {taken[:5]} are already used here")
        for f in man["files"]:
            if f["carried"] or f["path"].startswith(VIRTUAL):
                continue
            if not os.path.isfile(f["path"]):
                problems.append(f"missing here: {f['path']}")
            elif os.path.getsize(f["path"]) != f["size"]:
                problems.append(f"different here: {f['path']} ({os.path.getsize(f['path'])} vs {f['size']} bytes)")
        if problems:
            print("cryo: can't land this agent here:\n  " + "\n  ".join(problems[:10]))
            print("cryo: if those are program files of a different version, teleport again with "
                  "--carry-max 512 to bring them along.")
            print(f"cryo: nothing changed. on {man['from_sprite']}, `sudo cryo thaw {name}` brings it back.")
            sys.exit(1)

        for d in man["dirs"]:
            os.makedirs(d, exist_ok=True)
        if meta.get("tmux"):
            os.makedirs("/tmp/tmux-0", mode=0o700, exist_ok=True)
        d = agent_dir(name)
        shutil.rmtree(os.path.join(d, "images"), ignore_errors=True)
        os.makedirs(d, exist_ok=True)
        for member in tar.getmembers():
            if member.name.startswith("images/") and member.isfile():
                tar.extract(member, d, filter="data") if sys.version_info >= (3, 12) else tar.extract(member, d)
            elif member.name.startswith("files/") and member.isfile():
                dest = member.name[len("files"):]
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                tmp = dest + ".cryo-tmp"
                with tar.extractfile(member) as src, open(tmp, "wb") as out:
                    shutil.copyfileobj(src, out)
                os.chmod(tmp, member.mode)
                os.replace(tmp, dest)   # rename, so a running copy of the file is left alone

    ticket = a.url.rstrip("/").rsplit("/", 1)[-1]
    meta.pop("pid_start", None)   # the other Sprite's; thaw records ours
    meta.update(status="arriving", boot_id=boot_id(), came_from=man["from_sprite"],
                landing={"url": man["from_url"], "ticket": ticket, "packed_at": man["packed_at"],
                         "email": man.get("email")})
    save(meta)
    # the cgroups it lived in belong to the other Sprite; let it join ours
    ok, msg = thaw(meta, extra=MOVED_ARGS)
    if not ok:
        meta = fresh(meta)
        meta["status"] = "arriving"   # parked: only `cryo thaw` lands it, and that tells the source
        save(meta)
        print("cryo:", msg)
        print(f"cryo: the images are here now; fix the problem and `sudo cryo thaw {name}` to land it,")
        print(f"cryo: or on {man['from_sprite']}, `sudo cryo thaw {name}` brings it back there.")
        sys.exit(1)
    os.remove(path)
    landed(load(name), msg)


def landed(meta, msg):
    """A teleported agent is running here: tell the Sprite it came from, and the owner."""
    name, land = meta["name"], meta.get("landing") or {}
    total = now() - land.get("packed_at", now())
    src = meta.get("came_from", "?")
    event("arrived", name, from_sprite=src, seconds=round(total, 1))
    print(f"cryo: {msg}")
    print(f"cryo: {name} moved from {src} to {sprite_name()} ({total:.1f}s since its last breath there)")
    try:
        http_json("POST", f"{land['url']}/api/landed/{land['ticket']}",
                  {"sprite": sprite_name(), "seconds": round(total, 1)})
    except Exception as e:
        print(f"cryo: (couldn't tell {src} it landed: {e}; don't thaw it there or you'll have two)")
    meta.pop("landing", None)
    save(meta)
    c = load_config()
    if land.get("email") and not c.get("email"):
        c["email"] = land["email"]
        save_config(c)
    if c.get("email") and not c.get("resend_gateway"):
        gw = find_resend_gateway()
        if gw:
            c["resend_gateway"] = gw
            save_config(c)
    send_alert(f"cryo: {name} teleported to {sprite_name()}",
               f"{name} moved from {src} to {sprite_name()} with its memory intact.\n\n{msg}")
    try:
        listed = subprocess.run(["sprite-env", "services", "list"], capture_output=True, text=True).stdout
    except OSError:
        listed = ""
    if SERVICE not in listed.split():
        print("cryo: tip: `sudo cryo install` here keeps it alive across restarts on this Sprite too")


# ---------------------------------------------------------------- alerts (Resend connector)

CONFIG = os.path.join(STATE, "config.json")
GATEWAY = "https://api.sprites.dev/v1/gateway"


def load_config():
    try:
        with open(CONFIG) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_config(c):
    os.makedirs(STATE, exist_ok=True)
    with open(CONFIG + ".tmp", "w") as f:
        json.dump(c, f, indent=2)
        f.flush()
        os.fsync(f.fileno())
    os.replace(CONFIG + ".tmp", CONFIG)


def http_json(method, url, body=None, timeout=15):
    import urllib.request
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        raw = r.read()
    return json.loads(raw) if raw else {}


def find_resend_gateway():
    """Ask the Sprites gateway which connectors this Sprite may use and pick Resend.
    The key never comes near us: the gateway adds it on the way out."""
    listing = http_json("GET", f"{GATEWAY}/list")
    found = []

    def walk(x):
        if isinstance(x, dict):
            blob = json.dumps(x).lower()
            if "resend" in blob:
                for k in ("gateway_base_url", "base_url", "url", "gateway_url"):
                    v = x.get(k)
                    if isinstance(v, str) and "/gateway/resend/" in v:
                        found.append(v.rstrip("/"))
                cid = x.get("connection_id") or x.get("id")
                if isinstance(cid, str) and cid.startswith("conn_"):
                    found.append(f"{GATEWAY}/resend/{cid}")
            for v in x.values():
                walk(v)
        elif isinstance(x, list):
            for v in x:
                walk(v)
    walk(listing)
    return found[0] if found else None


def send_alert(subject, text):
    c = load_config()
    to, gw = c.get("email"), c.get("resend_gateway")
    if not to or not gw:
        return False
    try:
        http_json("POST", f"{gw}/emails", {
            "from": c.get("from", "cryo <onboarding@resend.dev>"),
            "to": [to], "subject": subject, "text": text,
        })
        event("alert", "*", subject=subject)
        return True
    except Exception as e:  # never let an alert break freezing/thawing
        event("alert_failed", "*", error=str(e)[:200])
        return False


def cmd_report(a):
    """Let an agent mail you its work through the Resend connector."""
    body = sys.stdin.read() if a.file == "-" else open(a.file).read() if a.file else a.text or ""
    ok = send_alert(a.subject, body)
    print("cryo: report sent" if ok else "cryo: report failed (run: cryo alerts --email you@example.com)")
    sys.exit(0 if ok else 1)


def cmd_say(a):
    """Type a message into a tmux-managed agent, e.g. a prompt for Claude Code."""
    m = load(a.name)
    if not m.get("tmux"):
        sys.exit(f"cryo: {a.name} isn't running in tmux")
    if not agent_alive(m):
        sys.exit(f"cryo: {a.name} isn't running ({m['status']}); `sudo cryo thaw {a.name}` first")
    sock = f"cryo-{a.name}"
    subprocess.run(["tmux", "-L", sock, "send-keys", "-t", a.name, "-l", a.text], check=True)
    time.sleep(0.3)
    subprocess.run(["tmux", "-L", sock, "send-keys", "-t", a.name, "Enter"], check=True)
    event("say", a.name, chars=len(a.text))


def cmd_peek(a):
