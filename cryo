#!/usr/bin/env python3
"""cryo - keep processes alive across Sprite cold wakes, host moves and checkpoint restores.

Runs as root. Every managed process is started by cryo (so it is root-owned and
CRIU can ptrace it without CAP_SYS_PTRACE), frozen to disk with CRIU, and thawed
again when cryo notices the machine has rebooted (boot_id changed).
"""
import argparse
import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
import time

STATE = os.environ.get("CRYO_HOME", "/var/lib/cryo")
EVENTS = os.path.join(STATE, "events.jsonl")


def boot_id():
    """Identity of the current environment. A Sprite checkpoint restore restarts
    the container but not the VM kernel, so the kernel boot_id stays the same.
    Combine it with the start time of PID 1 to catch both kinds of restart."""
    with open("/proc/sys/kernel/random/boot_id") as f:
        kernel = f.read().strip()
    try:
        with open("/proc/1/stat") as f:
            init_start = f.read().split(") ", 1)[1].split()[19]
    except (OSError, IndexError):
        init_start = "?"
    return f"{kernel}/{init_start}"


def now():
    return time.time()


# Two kernel features that CRIU can't checkpoint on a Sprite:
#  - io_uring rings (criu has no support for them at all)
#  - inotify watches on regular files: the root fs is an overlay, files report the
#    lower layer's st_dev while the watch records the overlay's, so neither
#    open_by_handle_at (needs CAP_DAC_READ_SEARCH, which Sprites don't grant) nor
#    criu's irmap can find them.
# cryo starts agents under a small seccomp filter that makes these syscalls fail
# with ENOSYS. Runtimes then fall back (libuv/bun -> epoll, file watchers -> off or
# polling). The filter is inherited by children and checkpointed by CRIU itself.
X86_64 = 0xC000003E
BLOCKED_SYSCALLS = {
    "io_uring_setup": 425,
    "inotify_init": 253,
    "inotify_init1": 294,
    "fanotify_init": 300,
}


def seccomp_blocker(blocked=tuple(BLOCKED_SYSCALLS.values()), errno_=38):
    import ctypes
    import struct

    def ins(code, jt, jf, k):
        return struct.pack("HBBI", code, jt, jf, k)

    LD_ABS, JEQ, RET = 0x20, 0x15, 0x06
    allow, deny = 0x7FFF0000, 0x00050000 | errno_
    n = len(blocked)
    prog = [ins(LD_ABS, 0, 0, 4),                 # arch
            ins(JEQ, 0, n + 2, X86_64),           # not x86_64 -> allow
            ins(LD_ABS, 0, 0, 0)]                 # syscall nr
    for i, nr in enumerate(blocked):
        prog.append(ins(JEQ, n - i, 0, nr))       # match -> deny
    prog += [ins(RET, 0, 0, allow), ins(RET, 0, 0, deny)]
    raw = b"".join(prog)

    def apply():
        libc = ctypes.CDLL(None, use_errno=True)
        buf = ctypes.create_string_buffer(raw, len(raw))

        class SockFprog(ctypes.Structure):
            _fields_ = [("len", ctypes.c_ushort), ("filter", ctypes.c_void_p)]
        fp = SockFprog(len(prog), ctypes.addressof(buf))
        if libc.prctl(38, 1, 0, 0, 0) != 0:                      # PR_SET_NO_NEW_PRIVS
            raise OSError(ctypes.get_errno(), "PR_SET_NO_NEW_PRIVS")
        if libc.prctl(22, 2, ctypes.byref(fp), 0, 0) != 0:       # PR_SET_SECCOMP, FILTER
            raise OSError(ctypes.get_errno(), "PR_SET_SECCOMP")
    return apply


def agent_dir(name):
    return os.path.join(STATE, "agents", name)


def load(name):
    p = os.path.join(agent_dir(name), "meta.json")
    if not os.path.exists(p):
        sys.exit(f"cryo: no agent named {name!r}")
    with open(p) as f:
        return json.load(f)


def save(meta):
    d = agent_dir(meta["name"])
    os.makedirs(d, exist_ok=True)
    tmp = os.path.join(d, "meta.json.tmp")
    with open(tmp, "w") as f:
        json.dump(meta, f, indent=2)
    os.replace(tmp, os.path.join(d, "meta.json"))


def all_agents():
    root = os.path.join(STATE, "agents")
    if not os.path.isdir(root):
        return []
    out = []
    for n in sorted(os.listdir(root)):
        if os.path.exists(os.path.join(root, n, "meta.json")):
            out.append(load(n))
    return out


def event(kind, name, **kw):
    os.makedirs(STATE, exist_ok=True)
    rec = {"t": now(), "kind": kind, "agent": name, "boot_id": boot_id(), **kw}
    with open(EVENTS, "a") as f:
        f.write(json.dumps(rec) + "\n")


def alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    # zombies count as dead
    try:
        with open(f"/proc/{pid}/stat") as f:
            return f.read().split(") ", 1)[1][0] != "Z"
    except FileNotFoundError:
        return False


def dir_size(path):
    total = 0
    for root, _, files in os.walk(path):
        for fn in files:
            try:
                total += os.path.getsize(os.path.join(root, fn))
            except OSError:
                pass
    return total


# Open TCP connections (an agent talking to its model API) are dumped with
# --tcp-established and come back closed (--tcp-close); the client reconnects.
# CRIU normally locks them with iptables while dumping, but there's no iptables
# on a Sprite and we don't need the lock when the sockets are restored closed.
def criu(args, log_dir):
    """Run criu, return (ok, seconds, error_lines)."""
    t0 = now()
    r = subprocess.run(["criu"] + args, capture_output=True, text=True)
    dt = now() - t0
    errs = []
    for line in (r.stderr or "").splitlines():
        # this one is noise on Sprites: no CAP_SYS_RESOURCE, criu carries on
        if "RLIMIT_NOFILE" in line:
            continue
        if "Error" in line:
            errs.append(line.strip())
    log = os.path.join(log_dir, "dump.log" if args[0] == "dump" else "restore.log")
    if os.path.exists(log):
        with open(log) as f:
            errs += [l.strip() for l in f if "Error" in l and "RLIMIT_NOFILE" not in l][-8:]
    return r.returncode == 0, dt, errs


# ---------------------------------------------------------------- commands

def high_pids():
    """CRIU restores a process with its original PID. After a restart, early boot
    processes get low PIDs, so start agents far above them to avoid collisions."""
    try:
        with open("/proc/sys/kernel/pid_max") as f:
            pid_max = int(f.read())
        base = min(pid_max - 100000, 300000)
        if base > 20000:
            import random
            with open("/proc/sys/kernel/ns_last_pid", "w") as f:
                f.write(str(base + random.randint(0, 50000)))
    except (OSError, ValueError):
        pass


def cmd_run(a):
    name = a.name
    if os.path.exists(os.path.join(agent_dir(name), "meta.json")) and alive(load(name).get("pid")):
        sys.exit(f"cryo: {name} is already running")
    d = agent_dir(name)
    os.makedirs(d, exist_ok=True)
    env = dict(os.environ)
    env["UV_USE_IO_URING"] = "0"
    blocker = None if a.no_filter else seccomp_blocker()
    command = a.command
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        sys.exit("cryo run: give a command, e.g. cryo run web -- python3 app.py")

    high_pids()
    if a.tmux:
        sock = f"cryo-{name}"
        shell_cmd = " ".join(shlex.quote(c) for c in command)
        subprocess.run(["tmux", "-L", sock, "kill-server"], capture_output=True)
        subprocess.run(["tmux", "-L", sock, "new", "-d", "-s", name, "-x", "200", "-y", "50", shell_cmd],
                       cwd=a.cwd, env=env, check=True, preexec_fn=blocker)
        time.sleep(0.5)
        r = subprocess.run(["tmux", "-L", sock, "display", "-p", "-t", name, "#{pid}"],
                           capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit(f"cryo: tmux session for {name} died right away:\n{r.stderr}")
        pid = int(r.stdout.strip())
    else:
        log = open(os.path.join(d, "output.log"), "ab")
        p = subprocess.Popen(command, cwd=a.cwd, env=env, stdin=subprocess.DEVNULL,
                             stdout=log, stderr=log, start_new_session=True,
                             preexec_fn=blocker)
        pid = p.pid

    meta = {
        "name": name, "command": command, "cwd": a.cwd, "tmux": a.tmux,
        "pid": pid, "status": "running", "started": now(), "boot_id": boot_id(),
        "last_freeze": None, "freeze_seconds": None, "image_bytes": None,
        "thaws": 0,
    }
    save(meta)
    event("run", name, pid=pid, command=command)
    print(f"cryo: {name} running as pid {pid}")


def process_tree(pid):
    kids = {}
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            with open(f"/proc/{d}/stat") as f:
                ppid = int(f.read().split(") ", 1)[1].split()[1])
        except (OSError, IndexError, ValueError):
            continue
        kids.setdefault(ppid, []).append(int(d))
    out, todo = [], [pid]
    while todo:
        p = todo.pop()
        out.append(p)
        todo += kids.get(p, [])
    return out


def watched_inodes(pid):
    """(dev, ino) of everything the process tree watches with inotify."""
    found = set()
    for p in process_tree(pid):
        try:
            fds = os.listdir(f"/proc/{p}/fdinfo")
        except OSError:
            continue
        for fd in fds:
            try:
                with open(f"/proc/{p}/fdinfo/{fd}") as f:
                    for line in f:
                        if line.startswith("inotify "):
                            kv = dict(x.split(":", 1) for x in line.split()[1:] if ":" in x)
                            sdev = int(kv["sdev"], 16)  # kernel dev_t: major<<20 | minor
                            found.add((sdev >> 20, sdev & 0xFFFFF, int(kv["ino"], 16)))
            except (OSError, KeyError, ValueError):
                continue
    return found


SKIP = {"node_modules", ".git", ".cache", "proc", "sys", ".npm", ".cargo", "site-packages"}


def irmap_paths(meta):
    """criu's irmap scan of a hint directory only looks one level deep, so give it
    the exact parent directory of every watched file. Find those by walking the
    usual places (cwd, home, /root, /tmp, /etc) a few levels down."""
    want = watched_inodes(meta["pid"])
    if not want:
        return []
    roots = [meta.get("cwd"), os.environ.get("HOME"), "/home", "/root", "/tmp", "/etc"]
    hits = set()

    def walk(path, depth):
        if not want or depth < 0:
            return
        try:
            entries = list(os.scandir(path))
        except OSError:
            return
        for e in entries:
            try:
                st = e.stat(follow_symlinks=False)
            except OSError:
                continue
            key = (os.major(st.st_dev), os.minor(st.st_dev), st.st_ino)
            if key in want:
                want.discard(key)
                hits.add(path)
                if e.is_dir(follow_symlinks=False):
                    hits.add(e.path)
            if e.is_dir(follow_symlinks=False) and e.name not in SKIP:
                walk(e.path, depth - 1)

    for r in roots:
        if r and os.path.isdir(r):
            try:
                st = os.stat(r)
                key = (os.major(st.st_dev), os.minor(st.st_dev), st.st_ino)
                if key in want:
                    want.discard(key)
                    hits.add(os.path.dirname(r) or "/")
                    hits.add(r)
            except OSError:
                pass
            walk(r, 4)
    if want:
        for maj, mnr, ino in sorted(want):
            print(f"cryo: warning, watched inode {ino} on dev {maj}:{mnr} not located"
                  " (deleted or replaced file?)", file=sys.stderr)
    return sorted(hits)


def freeze(meta, leave_running):
    name = meta["name"]
    d = agent_dir(name)
    if not alive(meta["pid"]):
        return False, f"{name}: not running"
    new = os.path.join(d, "images.new")
    shutil.rmtree(new, ignore_errors=True)
    os.makedirs(new)
    args = ["dump", "-t", str(meta["pid"]), "-D", new, "-o", "dump.log",
            "--tcp-established", "--file-locks", "--network-lock", "skip"]
    if meta.get("tmux"):
        args.append("--ext-unix-sk")
    # File watchers (inotify) are normally dumped as kernel file handles, which
    # needs CAP_DAC_READ_SEARCH. Sprites don't grant it, so make criu resolve
    # watched paths by scanning instead (irmap). Point it at the likely places.
    paths = irmap_paths(meta)
    if paths:
        args.append("--force-irmap")
        for path in paths:
            args += ["--irmap-scan-path", path]
    if leave_running:
        args.append("--leave-running")
    ok, dt, errs = criu(args, new)
    if not ok:
        event("freeze_failed", name, errors=errs)
        return False, f"{name}: freeze failed\n  " + "\n  ".join(errs[-6:])
    # Sprites don't grant CAP_SYS_TIME, so restoring a time namespace fails.
    for fn in os.listdir(new):
        if fn.startswith("timens-"):
            os.remove(os.path.join(new, fn))
    cur = os.path.join(d, "images")
    old = os.path.join(d, "images.old")
    shutil.rmtree(old, ignore_errors=True)
    if os.path.exists(cur):
        os.rename(cur, old)
    os.rename(new, cur)
    shutil.rmtree(old, ignore_errors=True)
    meta.update(last_freeze=now(), freeze_seconds=round(dt, 3),
                image_bytes=dir_size(cur), boot_id=boot_id(),
                status="running" if leave_running else "frozen")
    save(meta)
    event("freeze", name, seconds=round(dt, 3), bytes=meta["image_bytes"], leave_running=leave_running)
    return True, f"{name}: frozen in {dt:.2f}s ({meta['image_bytes'] / 1e6:.1f} MB)"


def thaw(meta):
    name = meta["name"]
    d = agent_dir(name)
    img = os.path.join(d, "images")
    if alive(meta["pid"]):
        return False, f"{name}: already running (pid {meta['pid']})"
    if not os.path.isdir(img):
        return False, f"{name}: nothing frozen to thaw"
    if os.path.exists(f"/proc/{meta['pid']}"):
        event("thaw_failed", name, errors=[f"pid {meta['pid']} is taken by another process"])
        return False, f"{name}: pid {meta['pid']} is taken by another process, can't thaw"
    pidfile = os.path.join(d, "thaw.pid")
    if os.path.exists(pidfile):
        os.remove(pidfile)
    args = ["restore", "-D", img, "-o", "restore.log", "-d", "--tcp-close",
            "--file-locks", "--network-lock", "skip", "--pidfile", pidfile]
    if meta.get("tmux"):
        args.append("--ext-unix-sk")
    ok, dt, errs = criu(args, img)
    if not ok:
        event("thaw_failed", name, errors=errs)
        return False, f"{name}: thaw failed\n  " + "\n  ".join(errs[-6:])
    pid = meta["pid"]
    if os.path.exists(pidfile):
        with open(pidfile) as f:
            pid = int(f.read().strip())
    lost = now() - (meta.get("last_freeze") or now())
    meta.update(pid=pid, status="running", boot_id=boot_id(), thaws=meta.get("thaws", 0) + 1)
    save(meta)
    event("thaw", name, seconds=round(dt, 3), pid=pid, since_freeze=round(lost, 1))
    return True, f"{name}: thawed in {dt:.2f}s as pid {pid} (state from {lost:.0f}s before)"


def cmd_freeze(a):
    targets = all_agents() if a.all else [load(a.name)]
    rc = 0
    for m in targets:
        ok, msg = freeze(m, a.keep)
        print("cryo:", msg)
        rc |= not ok
    sys.exit(rc)


def cmd_thaw(a):
    targets = all_agents() if a.all else [load(a.name)]
    rc = 0
    for m in targets:
        ok, msg = thaw(m)
        print("cryo:", msg)
        rc |= not ok
    sys.exit(rc)


def cmd_boot(a):
    """Thaw every agent whose process died because the machine restarted."""
    bid = boot_id()
    for m in all_agents():
        if alive(m["pid"]) or m["status"] == "stopped":
            continue
        if m.get("boot_id") != bid:
            event("reboot_detected", m["name"], old_boot_id=m.get("boot_id"))
        ok, msg = thaw(m)
        print("cryo:", msg)


def cmd_watch(a):
    """Thaw anything that died, then keep fresh frozen copies of everything running."""
    print(f"cryo: watching, snapshot every {a.interval}s")
    cmd_boot(a)
    stop = False

    def bye(*_):
        nonlocal stop
        stop = True
    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)
    while not stop:
        for m in all_agents():
            if m["status"] == "stopped":
                continue
            if alive(m["pid"]):
                ok, msg = freeze(m, leave_running=True)
                if not ok:
                    print("cryo:", msg, flush=True)
            else:
                ok, msg = thaw(m)
                print("cryo:", msg, flush=True)
        for _ in range(a.interval * 10):
            if stop:
                break
            time.sleep(0.1)


def cmd_stop(a):
    m = load(a.name)
    if alive(m["pid"]):
        os.killpg(os.getpgid(m["pid"]), signal.SIGTERM)
    m["status"] = "stopped"
    save(m)
    event("stop", a.name)
    print(f"cryo: {a.name} stopped (frozen copy kept)")



# ---------------------------------------------------------------- http api

TOKEN_FILE = os.path.join(STATE, "api_token")


def api_token():
    os.makedirs(STATE, exist_ok=True)
    if not os.path.exists(TOKEN_FILE):
        import secrets
        with open(TOKEN_FILE, "w") as f:
            f.write(secrets.token_urlsafe(24))
        os.chmod(TOKEN_FILE, 0o600)
    with open(TOKEN_FILE) as f:
        return f.read().strip()


def public_agent(m):
    return {
        "name": m["name"],
        "program": os.path.basename(m["command"][0]) if m.get("command") else "?",
        "pid": m["pid"], "alive": alive(m["pid"]), "status": m["status"],
        "started": m.get("started"), "last_freeze": m.get("last_freeze"),
        "freeze_seconds": m.get("freeze_seconds"), "image_bytes": m.get("image_bytes"),
        "thaws": m.get("thaws", 0),
    }


def read_events(limit):
    if not os.path.exists(EVENTS):
        return []
    with open(EVENTS) as f:
        lines = f.readlines()[-limit:]
    out = []
    for l in lines:
        try:
            e = json.loads(l)
            # the api can be public: never echo command lines (they can carry secrets)
            e.pop("command", None)
            e.pop("output", None)
            out.append(e)
        except ValueError:
            pass
    return out


def cmd_serve(a):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    token = api_token()
    last_restart = [0.0]
    print(f"cryo: api on :{a.port}  (token in {TOKEN_FILE})", flush=True)

    def restart_sprite():
        # take a checkpoint (it includes the newest frozen images), then restore it.
        # Restoring restarts every process on the Sprite, including this server;
        # the cryo service comes back up and thaws the agents.
        name = a.sprite or os.environ.get("SPRITE_NAME") or os.uname().nodename
        for m in all_agents():
            if alive(m["pid"]) and m["status"] != "stopped":
                freeze(m, leave_running=True)
        event("restart_requested", "*", sprite=name)
        r = subprocess.run(["sprite", "checkpoint", "create", "-s", name, "--comment", "cryo restart"],
                           capture_output=True, text=True)
        import re
        mm = re.search(r"\b(v\d+)\b", r.stdout + r.stderr)
        if not mm:
            event("restart_failed", "*", output=(r.stdout + r.stderr)[-300:])
            return
        subprocess.Popen(["sprite", "restore", "-s", name, mm.group(1)],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    class H(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def send(self, code, body, ctype="application/json"):
            data = body if isinstance(body, bytes) else json.dumps(body).encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Access-Control-Allow-Headers", "Authorization, Content-Type")
            self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def authed(self):
            return self.headers.get("Authorization", "") == f"Bearer {token}"

        def do_OPTIONS(self):
            self.send(204, b"")

        def do_GET(self):
            path = self.path.split("?")[0]
            if path == "/api/state":
                return self.send(200, {
                    "sprite": a.sprite or os.environ.get("SPRITE_NAME") or os.uname().nodename,
                    "environment": boot_id(), "now": now(),
                    "agents": [public_agent(m) for m in all_agents()],
                })
            if path == "/api/events":
                return self.send(200, read_events(300))
            if path in ("/", "/index.html") and a.ui and os.path.exists(a.ui):
                with open(a.ui, "rb") as f:
                    return self.send(200, f.read(), "text/html; charset=utf-8")
            if path == "/healthz":
                return self.send(200, {"ok": True})
            self.send(404, {"error": "not found"})

        def do_POST(self):
            path = self.path.split("?")[0]
            public_ok = path == "/api/restart" and a.public_restart
            if not (self.authed() or public_ok):
                return self.send(401, {"error": "unauthorized"})
            if path == "/api/restart":
                if now() - last_restart[0] < a.restart_cooldown:
                    wait = int(a.restart_cooldown - (now() - last_restart[0]))
                    return self.send(429, {"error": f"cooling down, try again in {wait}s"})
                last_restart[0] = now()
                import threading
                threading.Thread(target=restart_sprite, daemon=True).start()
                return self.send(202, {"ok": True, "message": "restarting the Sprite"})
            parts = path.strip("/").split("/")
            if len(parts) == 3 and parts[0] == "api" and parts[1] in ("freeze", "thaw"):
                try:
                    m = load(parts[2])
                except SystemExit:
                    return self.send(404, {"error": "no such agent"})
                ok, msg = freeze(m, True) if parts[1] == "freeze" else thaw(m)
                return self.send(200 if ok else 500, {"ok": ok, "message": msg})
            self.send(404, {"error": "not found"})

    ThreadingHTTPServer(("0.0.0.0", a.port), H).serve_forever()

SERVICE = "cryo"
WRAPPER = "/usr/local/sbin/cryo-watch"
API_SERVICE = "cryo-api"
API_WRAPPER = "/usr/local/sbin/cryo-api"


def cmd_install(a):
    """Register `cryo watch` as a Sprite service so it starts on every boot,
    thaws whatever died, and keeps snapshotting."""
    me = os.path.realpath(sys.argv[0])
    with open(WRAPPER, "w") as f:
        f.write("#!/bin/sh\n"
                f"exec sudo env PATH={shlex.quote(os.environ.get('PATH', ''))} "
                f"HOME={shlex.quote(os.environ.get('HOME', '/root'))} "
                f"{shlex.quote(me)} watch --interval {a.interval}\n")
    os.chmod(WRAPPER, 0o755)
    subprocess.run(["sprite-env", "services", "delete", SERVICE], capture_output=True)
    r = subprocess.run(["sprite-env", "services", "create", SERVICE, "--cmd", WRAPPER, "--no-stream"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"cryo: could not create the service:\n{r.stdout}{r.stderr}\n"
                 f"try: sprite-env services create {SERVICE} --cmd {WRAPPER}")
    event("install", SERVICE, interval=a.interval)
    print(f"cryo: installed as Sprite service '{SERVICE}' (snapshot every {a.interval}s, thaw on boot)")
    if a.api:
        extra = " --public-restart" if a.public_restart else ""
        sprite_name = a.sprite or os.uname().nodename
        with open(API_WRAPPER, "w") as f:
            f.write("#!/bin/sh\n"
                    f"exec sudo env PATH={shlex.quote(os.environ.get('PATH', ''))} "
                    f"HOME={shlex.quote(os.environ.get('HOME', '/root'))} "
                    f"{shlex.quote(me)} serve --port 8080 --sprite {shlex.quote(sprite_name)}{extra}"
                    f"{' --ui ' + shlex.quote(os.path.realpath(a.ui)) if a.ui else ''}\n")
        os.chmod(API_WRAPPER, 0o755)
        subprocess.run(["sprite-env", "services", "delete", API_SERVICE], capture_output=True)
        r = subprocess.run(["sprite-env", "services", "create", API_SERVICE, "--cmd", API_WRAPPER,
                            "--http-port", "8080", "--no-stream"], capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit(f"cryo: could not create the api service:\n{r.stdout}{r.stderr}")
        print(f"cryo: api service '{API_SERVICE}' on the Sprite URL, admin token: {api_token()}")


def cmd_uninstall(a):
    subprocess.run(["sprite-env", "services", "delete", SERVICE])
    subprocess.run(["sprite-env", "services", "delete", API_SERVICE], capture_output=True)
    print("cryo: service removed")


def cmd_ls(a):
    agents = all_agents()
    if a.json:
        for m in agents:
            m["alive"] = alive(m["pid"])
        print(json.dumps(agents, indent=2))
        return
    if not agents:
        print("no agents. start one: cryo run NAME -- COMMAND")
        return
    print(f"{'NAME':<14}{'PID':>8}  {'STATE':<9}{'LAST FREEZE':>12}{'IMAGE':>10}{'THAWS':>7}")
    for m in agents:
        st = "running" if alive(m["pid"]) else m["status"]
        if st == "running" and not alive(m["pid"]):
            st = "dead"
        lf = f"{now() - m['last_freeze']:.0f}s ago" if m.get("last_freeze") else "never"
        size = f"{m['image_bytes'] / 1e6:.1f}MB" if m.get("image_bytes") else "-"
        print(f"{m['name']:<14}{m['pid']:>8}  {st:<9}{lf:>12}{size:>10}{m.get('thaws', 0):>7}")


def main():
    if os.geteuid() != 0:
        sys.exit("cryo needs root (run it with sudo)")
    p = argparse.ArgumentParser(prog="cryo")
    sub = p.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("run", help="start a process under cryo")
    r.add_argument("name")
    r.add_argument("--tmux", action="store_true", help="run inside a detached tmux session")
    r.add_argument("--cwd", default=os.getcwd())
    r.add_argument("--no-filter", action="store_true",
                   help="don't block io_uring/inotify (freezing may then fail)")
    r.add_argument("command", nargs="*", help="after --")
    r.set_defaults(fn=cmd_run)

    f = sub.add_parser("freeze", help="save a process to disk")
    f.add_argument("name", nargs="?")
    f.add_argument("--all", action="store_true")
    f.add_argument("--keep", action="store_true", help="keep it running after the snapshot")
    f.set_defaults(fn=cmd_freeze)

    t = sub.add_parser("thaw", help="bring a frozen process back")
    t.add_argument("name", nargs="?")
    t.add_argument("--all", action="store_true")
    t.set_defaults(fn=cmd_thaw)

    b = sub.add_parser("boot", help="thaw everything that died in a restart")
    b.set_defaults(fn=cmd_boot)

    w = sub.add_parser("watch", help="snapshot continuously and thaw after restarts")
    w.add_argument("--interval", type=int, default=30)
    w.set_defaults(fn=cmd_watch)

    s = sub.add_parser("stop", help="stop a process and stop managing it")
    s.add_argument("name")
    s.set_defaults(fn=cmd_stop)

    i = sub.add_parser("install", help="run cryo watch as a Sprite service on every boot")
    i.add_argument("--interval", type=int, default=60)
    i.add_argument("--api", action="store_true", help="also serve the dashboard api on the Sprite URL")
    i.add_argument("--sprite", help="this Sprite's name (for the restart button)")
    i.add_argument("--public-restart", action="store_true")
    i.add_argument("--ui", help="html file for the dashboard")
    i.set_defaults(fn=cmd_install)

    u = sub.add_parser("uninstall", help="remove the Sprite service")
    u.set_defaults(fn=cmd_uninstall)

    sv = sub.add_parser("serve", help="small http api for the dashboard")
    sv.add_argument("--port", type=int, default=8080)
    sv.add_argument("--sprite", help="sprite name (for the restart button)")
    sv.add_argument("--ui", help="html file to serve at /")
    sv.add_argument("--public-restart", action="store_true",
                    help="let anyone press the restart button (rate limited)")
    sv.add_argument("--restart-cooldown", type=int, default=180)
    sv.set_defaults(fn=cmd_serve)

    l = sub.add_parser("ls", help="list managed processes")
    l.add_argument("--json", action="store_true")
    l.set_defaults(fn=cmd_ls)

    a = p.parse_args()
    if a.cmd in ("freeze", "thaw") and not a.all and not a.name:
        p.error(f"{a.cmd}: give a name or --all")
    a.fn(a)


if __name__ == "__main__":
    main()
