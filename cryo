# ---------------------------------------------------------------- http api

TOKEN_FILE = os.path.join(STATE, "api_token")


def api_token():
    os.makedirs(STATE, exist_ok=True)
    if not os.path.exists(TOKEN_FILE):
        import secrets
        with open(TOKEN_FILE, "w") as f:
            f.write(secrets.token_urlsafe(24))
        os.chmod(TOKEN_FILE, 0o600)
    with open(TOKEN_FILE) as f:
        return f.read().strip()


def public_agent(m):
    return {
        "name": m["name"],
        "program": os.path.basename(m["command"][0]) if m.get("command") else "?",
        "pid": m["pid"], "alive": agent_alive(m), "status": m["status"],
        "started": m.get("started"), "last_freeze": m.get("last_freeze"),
        "freeze_seconds": m.get("freeze_seconds"), "image_bytes": m.get("image_bytes"),
        "paused_seconds": m.get("paused_seconds"),
        "thaws": m.get("thaws", 0), "moved_to": m.get("moved_to"), "came_from": m.get("came_from"),
    }


def read_events(limit):
    if not os.path.exists(EVENTS):
        return []
    with open(EVENTS) as f:
        lines = f.readlines()[-limit:]
    out = []
    for l in lines:
        try:
            e = json.loads(l)
            # the api can be public: never echo command lines (they can carry secrets)
            e.pop("command", None)
            e.pop("output", None)
            out.append(e)
        except ValueError:
            pass
    return out


def cmd_serve(a):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    token = api_token()
    last_restart = [0.0]
    print(f"cryo: api on :{a.port}  (token in {TOKEN_FILE})", flush=True)

    def restart_sprite():
        # take a checkpoint (it includes the newest frozen images), then restore it.
        # Restoring restarts every process on the Sprite, including this server;
        # the cryo service comes back up and thaws the agents.
        name = a.sprite or os.environ.get("SPRITE_NAME") or os.uname().nodename
        for m in all_agents():
            if agent_alive(m) and m["status"] != "stopped":
                freeze(m, leave_running=True)
        event("restart_requested", "*", sprite=name)
        r = subprocess.run(["sprite", "checkpoint", "create", "-s", name, "--comment", "cryo restart"],
                           capture_output=True, text=True)
        import re
        mm = re.search(r"\b(v\d+)\b", r.stdout + r.stderr)
        if not mm:
            event("restart_failed", "*", output=(r.stdout + r.stderr)[-300:])
            return
        subprocess.Popen(["sprite", "restore", "-s", name, mm.group(1)],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    recent = []   # times of recent public word saves

    class H(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def send(self, code, body, ctype="application/json"):
            data = body if isinstance(body, bytes) else json.dumps(body).encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Access-Control-Allow-Headers", "Authorization, Content-Type")
            self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def authed(self):
            return self.headers.get("Authorization", "") == f"Bearer {token}"

        def do_OPTIONS(self):
            self.send(204, b"")

        def do_GET(self):
            path = self.path.split("?")[0]
            if path == "/api/state":
                return self.send(200, {
                    "sprite": a.sprite or os.environ.get("SPRITE_NAME") or os.uname().nodename,
                    "environment": boot_id(), "now": now(),
                    "agents": [public_agent(m) for m in all_agents()],
                })
            if path == "/api/events":
                return self.send(200, read_events(300))
            if path in ("/", "/index.html") and a.ui and os.path.exists(a.ui):
                with open(a.ui, "rb") as f:
                    return self.send(200, f.read(), "text/html; charset=utf-8")
            if path == "/healthz":
                return self.send(200, {"ok": True})
            if path.startswith("/api/bundle/"):
                return self.bundle(path.rsplit("/", 1)[-1])
            if path == "/api/words" or path.startswith("/api/words/"):
                return self.keeper("GET", path[len("/api"):])
            self.send(404, {"error": "not found"})

        def keeper(self, method, path, body=None):
            """Pass a visitor's word to keeper (demo/keeper.py), a process that holds
            words only in memory. It listens on localhost; this is its only door."""
            import urllib.error
            import urllib.request
            req = urllib.request.Request(f"http://127.0.0.1:{a.keeper_port}{path}", data=body, method=method,
                                         headers={"Content-Type": "application/json"})
            try:
                with urllib.request.urlopen(req, timeout=5) as r:
                    return self.send(r.status, r.read())
            except urllib.error.HTTPError as e:
                return self.send(e.code, e.read())
            except OSError:
                return self.send(503, {"error": "keeper isn't answering (restarting?)"})

        def bundle(self, ticket):
            # only `cryo import` may take it: a browser, a link preview or a stray click
            # gets a 404 and doesn't use the link up. It keeps working until the agent lands.
            if self.headers.get("X-Cryo-Import") != "1":
                return self.send(404, {"error": "not found"})
            tickets = load_tickets()
            t = tickets.get(ticket)
            if not t or now() > t["expires"] or not os.path.exists(t["bundle"]):
                return self.send(404, {"error": "no such ticket (links last 2 hours, until the agent lands)"})
            t["fetched"] = now()
            save_tickets(tickets)
            size = os.path.getsize(t["bundle"])
            self.send_response(200)
            self.send_header("Content-Type", "application/gzip")
            self.send_header("Content-Length", str(size))
            self.end_headers()
            with open(t["bundle"], "rb") as f:
                shutil.copyfileobj(f, self.wfile, 1 << 20)
            event("bundle_sent", t["name"], bytes=size)

        def do_POST(self):
            path = self.path.split("?")[0]
            if path.startswith("/api/landed/"):
                return self.landed(path.rsplit("/", 1)[-1])
            if path == "/api/words":
                # anyone may leave a word; keep it to a trickle
                recent[:] = [t for t in recent if now() - t < 60]
                if len(recent) >= 30:
                    return self.send(429, {"error": "lots of people are doing this; try again in a minute"})
                recent.append(now())
                n = min(int(self.headers.get("Content-Length") or 0), 2048)
                return self.keeper("POST", "/words", self.rfile.read(n))
            public_ok = path == "/api/restart" and a.public_restart
            if not (self.authed() or public_ok):
                return self.send(401, {"error": "unauthorized"})
            if path == "/api/restart":
                if now() - last_restart[0] < a.restart_cooldown:
                    wait = int(a.restart_cooldown - (now() - last_restart[0]))
                    return self.send(429, {"error": f"cooling down, try again in {wait}s"})
                last_restart[0] = now()
                import threading
                threading.Thread(target=restart_sprite, daemon=True).start()
                return self.send(202, {"ok": True, "message": "restarting the Sprite"})
            parts = path.strip("/").split("/")
            if len(parts) == 3 and parts[0] == "api" and parts[1] in ("freeze", "thaw"):
                try:
                    m = load(parts[2])
                except SystemExit:
                    return self.send(404, {"error": "no such agent"})
                ok, msg = freeze(m, True) if parts[1] == "freeze" else thaw(m)
                return self.send(200 if ok else 500, {"ok": ok, "message": msg})
            self.send(404, {"error": "not found"})

        def landed(self, ticket):
            tickets = load_tickets()
            t = tickets.get(ticket)
            if not t or not t.get("fetched"):
                return self.send(404, {"error": "no such ticket"})
            try:
                body = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
            except ValueError:
                body = {}
            m = load(t["name"])
            m.update(status="moved", moved_to=str(body.get("sprite", "?"))[:64], moved_at=now())
            save(m)
            event("landed", t["name"], to=m["moved_to"], seconds=body.get("seconds"))
            try:
                os.remove(t["bundle"])
            except OSError:
                pass
            del tickets[ticket]
            save_tickets(tickets)
            self.send(200, {"ok": True})

    ThreadingHTTPServer(("0.0.0.0", a.port), H).serve_forever()

SERVICE = "cryo"
WRAPPER = "/usr/local/sbin/cryo-watch"
API_SERVICE = "cryo-api"
API_WRAPPER = "/usr/local/sbin/cryo-api"


def cmd_install(a):
    """Register `cryo watch` as a Sprite service so it starts on every boot,
    thaws whatever died, and keeps snapshotting."""
    me = os.path.realpath(sys.argv[0])
    with open(WRAPPER, "w") as f:
        f.write("#!/bin/sh\n"
                f"exec sudo env PATH={shlex.quote(os.environ.get('PATH', ''))} "
                f"HOME={shlex.quote(os.environ.get('HOME', '/root'))} "
                f"{shlex.quote(me)} watch --interval {a.interval}\n")
    os.chmod(WRAPPER, 0o755)
    subprocess.run(["sprite-env", "services", "delete", SERVICE], capture_output=True)
    r = subprocess.run(["sprite-env", "services", "create", SERVICE, "--cmd", WRAPPER, "--no-stream"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"cryo: could not create the service:\n{r.stdout}{r.stderr}\n"
                 f"try: sprite-env services create {SERVICE} --cmd {WRAPPER}")
    event("install", SERVICE, interval=a.interval)
    print(f"cryo: installed as Sprite service '{SERVICE}' (snapshot after activity, thaw on boot)")
    c = load_config()
    if a.url:
        c["url"] = a.url.rstrip("/")
    if a.sprite:
        c["sprite"] = a.sprite
    save_config(c)
    if a.api:
        extra = " --public-restart" if a.public_restart else ""
        sprite_name = a.sprite or os.uname().nodename
        with open(API_WRAPPER, "w") as f:
            f.write("#!/bin/sh\n"
                    f"exec sudo env PATH={shlex.quote(os.environ.get('PATH', ''))} "
                    f"HOME={shlex.quote(os.environ.get('HOME', '/root'))} "
                    f"{shlex.quote(me)} serve --port 8080 --sprite {shlex.quote(sprite_name)}{extra}"
                    f"{' --ui ' + shlex.quote(os.path.realpath(a.ui)) if a.ui else ''}\n")
        os.chmod(API_WRAPPER, 0o755)
        subprocess.run(["sprite-env", "services", "delete", API_SERVICE], capture_output=True)
        r = subprocess.run(["sprite-env", "services", "create", API_SERVICE, "--cmd", API_WRAPPER,
                            "--http-port", "8080", "--no-stream"], capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit(f"cryo: could not create the api service:\n{r.stdout}{r.stderr}")
        api_token()
        print(f"cryo: api service '{API_SERVICE}' on the Sprite URL "
              f"(admin token: sudo cat {TOKEN_FILE})")


def cmd_doctor(a):
    """Why is something slow? Show where cryo's services and agents run (cgroup,
    CPU/IO limits, PATH) and time a snapshot of the smallest agent from here."""
    def cg(pid):
        try:
            with open(f"/proc/{pid}/cgroup") as f:
                path = f.read().strip().split("::")[-1]
        except OSError:
            return "?", {}
        lim = {}
        for k in ("cpu.max", "cpu.weight", "io.max", "memory.max", "memory.high"):
            try:
                with open(f"/sys/fs/cgroup{path}/{k}") as f:
                    v = f.read().strip().replace("\n", "; ")
                    if v and v not in ("max", "max 100000", "100"):
                        lim[k] = v
            except OSError:
                pass
        return path, lim

    def env_path(pid):
        try:
            with open(f"/proc/{pid}/environ", "rb") as f:
                for kv in f.read().split(b"\0"):
                    if kv.startswith(b"PATH="):
                        return kv[5:].decode()
        except OSError:
            pass
        return "?"

    rows = [("this shell", os.getppid())]
    for name, pat in (("cryo watch", "cryo watch"), ("cryo serve", "cryo serve")):
        r = subprocess.run(["pgrep", "-f", pat], capture_output=True, text=True)
        for pid in r.stdout.split()[:1]:
            rows.append((name, int(pid)))
    for m in all_agents():
        if agent_alive(m):
            rows.append((f"agent {m['name']}", m["pid"]))
    for name, pid in rows:
        path, lim = cg(pid)
        print(f"{name:18} pid {pid:<8} cgroup {path}")
        if lim:
            print(f"{'':18} limits: " + ", ".join(f"{k}={v}" for k, v in lim.items()))
        if name.startswith("cryo"):
            p = env_path(pid)
            dirs = [d for d in p.split(":") if d and d != "?"] + ["/usr/bin", "/usr/sbin", "/usr/local/bin"]
            found = next((os.path.join(d, "crit") for d in dirs if os.path.exists(os.path.join(d, "crit"))), None)
            print(f"{'':18} PATH {p}   crit: {found or 'NOT FOUND'}")
    live = [m for m in all_agents() if agent_alive(m)]
    if live:
        m = min(live, key=lambda m: m.get("image_bytes") or 1 << 40)
        ok, msg = freeze(m, leave_running=True)
        print("test from here:", msg)


def cmd_uninstall(a):
    subprocess.run(["sprite-env", "services", "delete", SERVICE])
    subprocess.run(["sprite-env", "services", "delete", API_SERVICE], capture_output=True)
    print("cryo: service removed")


def cmd_ls(a):
    agents = all_agents()
    if a.json:
        for m in agents:
            m["alive"] = agent_alive(m)
        print(json.dumps(agents, indent=2))
        return
    if not agents:
        print("no agents. start one: cryo run NAME -- COMMAND")
        return
    print(f"{'NAME':<14}{'PID':>8}  {'STATE':<9}{'LAST FREEZE':>12}{'IMAGE':>10}{'THAWS':>7}")
    for m in agents:
        st = "running" if agent_alive(m) else m["status"]
        if st == "running" and not agent_alive(m):
            st = "dead"
        lf = f"{now() - m['last_freeze']:.0f}s ago" if m.get("last_freeze") else "never"
        size = f"{m['image_bytes'] / 1e6:.1f}MB" if m.get("image_bytes") else "-"
        print(f"{m['name']:<14}{m['pid']:>8}  {st:<9}{lf:>12}{size:>10}{m.get('thaws', 0):>7}")


def main():
    if os.geteuid() != 0:
        sys.exit("cryo needs root (run it with sudo)")
    p = argparse.ArgumentParser(prog="cryo")
    sub = p.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("run", help="start a process under cryo")
    r.add_argument("name")
    r.add_argument("--tmux", action="store_true", help="run inside a detached tmux session")
    r.add_argument("--cwd", default=os.getcwd())
    r.add_argument("--no-filter", action="store_true",
                   help="don't block io_uring/inotify (freezing may then fail)")
    r.add_argument("command", nargs="*", help="after --")
    r.set_defaults(fn=cmd_run)

    f = sub.add_parser("freeze", help="save a process to disk")
    f.add_argument("name", nargs="?")
    f.add_argument("--all", action="store_true")
    f.add_argument("--stop", action="store_true", help="stop it after the snapshot (default: keep it running)")
    f.add_argument("--keep", action="store_true", help=argparse.SUPPRESS)  # the old default flag, now a no-op
    f.set_defaults(fn=cmd_freeze)

    t = sub.add_parser("thaw", help="bring a frozen process back")
    t.add_argument("name", nargs="?")
    t.add_argument("--all", action="store_true")
    t.add_argument("--force", action="store_true", help="thaw even if it moved to another Sprite")
    t.set_defaults(fn=cmd_thaw)

    b = sub.add_parser("boot", help="thaw everything that died in a restart")
    b.set_defaults(fn=cmd_boot)

    w = sub.add_parser("watch", help="snapshot continuously and thaw after restarts")
    w.add_argument("--interval", type=int, default=60)
    w.add_argument("--settle", type=int, default=5)
    w.add_argument("--work-ticks", type=int, default=30, help="CPU ticks (1/100 s) that count as real work")
    w.add_argument("--burst", type=int, default=10, help="CPU ticks in one 2 s check that count as activity (10 = 5%% CPU)")
    w.add_argument("--drift", type=int, default=900, help="fold in small idle changes this often (s)")
    w.set_defaults(fn=cmd_watch)

    s = sub.add_parser("stop", help="stop a process and stop managing it")
    s.add_argument("name")
    s.set_defaults(fn=cmd_stop)

    i = sub.add_parser("install", help="run cryo watch as a Sprite service on every boot")
    i.add_argument("--interval", type=int, default=60)
    i.add_argument("--api", action="store_true", help="also serve the dashboard api on the Sprite URL")
    i.add_argument("--sprite", help="this Sprite's name (for the restart button)")
    i.add_argument("--public-restart", action="store_true")
    i.add_argument("--ui", help="html file for the dashboard")
    i.add_argument("--url", help="this Sprite's public URL (other Sprites pull teleported agents from it)")
    i.set_defaults(fn=cmd_install)

    u = sub.add_parser("uninstall", help="remove the Sprite service")
    u.set_defaults(fn=cmd_uninstall)

    al = sub.add_parser("alerts", help="email alerts through the Sprites Resend connector")
    al.add_argument("--email", help="where to send alerts")
    al.add_argument("--gateway", help="Resend gateway URL from the connector page (auto-detected if omitted)")
    al.add_argument("--test", action="store_true", help="send a test email")
    al.add_argument("--every", type=int, metavar="MINUTES",
                    help="at most one 'survived a restart' email per this many minutes (default 30)")
    al.set_defaults(fn=cmd_alerts)

    rp = sub.add_parser("report", help="email a report through the Resend connector")
    rp.add_argument("--subject", required=True)
    rp.add_argument("--file", help="file to send, or - for stdin")
    rp.add_argument("--text")
    rp.set_defaults(fn=cmd_report)

    sy = sub.add_parser("say", help="type a message into a tmux agent")
    sy.add_argument("name")
    sy.add_argument("text")
    sy.set_defaults(fn=cmd_say)

    pk = sub.add_parser("peek", help="show a tmux agent's screen")
    pk.add_argument("name")
    pk.add_argument("-n", type=int, default=25)
    pk.set_defaults(fn=cmd_peek)

    ev = sub.add_parser("events", help="show the last events")
    ev.add_argument("-n", type=int, default=20)
    ev.set_defaults(fn=lambda a: [print(json.dumps(e)) for e in read_events(a.n)])

    sv = sub.add_parser("serve", help="small http api for the dashboard")
    sv.add_argument("--port", type=int, default=8080)
    sv.add_argument("--sprite", help="sprite name (for the restart button)")
    sv.add_argument("--ui", help="html file to serve at /")
    sv.add_argument("--public-restart", action="store_true",
                    help="let anyone press the restart button (rate limited)")
    sv.add_argument("--restart-cooldown", type=int, default=180)
    sv.add_argument("--keeper-port", type=int, default=8091)
    sv.set_defaults(fn=cmd_serve)

    tp = sub.add_parser("teleport", help="move a running agent to another Sprite")
    tp.add_argument("name")
    tp.add_argument("--to", help="the other Sprite's name (tries `sprite exec` to pull it there)")
    tp.add_argument("--url", help="this Sprite's public URL, if not set at install")
    tp.add_argument("--carry-max", type=int, default=64,
                    help="carry files up to this many MB; bigger ones must already match on the other side")
    tp.set_defaults(fn=cmd_teleport)

    im = sub.add_parser("import", help="receive an agent teleported from another Sprite")
    im.add_argument("url", help="the link `cryo teleport` printed")
    im.add_argument("--force", action="store_true", help="land even if this Sprite's clock is behind")
    im.set_defaults(fn=cmd_import)

    dr = sub.add_parser("doctor", help="where services and agents run, and how fast a snapshot is")
    dr.set_defaults(fn=cmd_doctor)

    l = sub.add_parser("ls", help="list managed processes")
    l.add_argument("--json", action="store_true")
    l.set_defaults(fn=cmd_ls)

    a = p.parse_args()
    if a.cmd in ("freeze", "thaw") and not a.all and not a.name:
        p.error(f"{a.cmd}: give a name or --all")
    a.fn(a)


if __name__ == "__main__":
    main()
